# Client environment variables — PUBLIC ONLY (safe to commit; put NO secrets here).
# Copy to .env.local and adjust per environment. All NEXT_PUBLIC_* vars are
# inlined into the browser bundle at build time.

# Backend API host (Express server). Falls back to https://lmsserver-yeve.onrender.com if unset.
NEXT_PUBLIC_API_URL=https://lmsserver-yeve.onrender.com

# Code-execution server (see next.config.ts).
NEXT_PUBLIC_CODE_SERVER_URL=http://localhost:8080

# Self-hosted Piston execute endpoint (same-origin proxy; see next.config.ts rewrites).
NEXT_PUBLIC_PISTON_URL=/piston-api/execute

# Gemini API key (AI Assistant, AI Summary, AI question generation).
# NEXT_PUBLIC_* is inlined into the browser bundle — this key is visible to anyone
# who opens devtools. Fine for a demo; move behind a server proxy before production.
NEXT_PUBLIC_GEMINI_API_KEY=
